module

import SmallPresentation
import SmallPresentation.SmallCancellationFoundations
public meta import Lean

/-!
# Trust checks

Every checkpoint must use only `propext`, `Classical.choice`, and `Quot.sound`.
The command fails on a missing declaration or any additional axiom. The full build
also checks the source admission ledger and records source and artifact hashes.
-/

open Lean Elab Command in
elab "#audit_complete " target:ident : command => do
  let name := target.getId
  unless ((← getEnv).find? name).isSome do
    throwError "Unknown audit target: {name}"
  let axioms ← Lean.collectAxioms name
  for axiomName in axioms do
    unless #[`propext, `Classical.choice, `Quot.sound].contains axiomName do
      throwError "{name} is not complete: unexpected axiom {axiomName}"
  logInfo m!"COMPLETE {name}: {axioms}"

