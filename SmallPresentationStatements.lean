module

public import Mathlib.Algebra.Group.Torsion
public import Mathlib.Computability.RE
public import Mathlib.GroupTheory.Abelianization.Defs
public import Mathlib.GroupTheory.PresentedGroup

/-!
# Small-presentation result statements

The result statements below are theorems with `sorry` proof placeholders.
Their proofs remain unfinished; supporting definitions and structures are provided.
See Proofs.md for provenance and conventions.

The foundation is extracted from 32805433/Adian-Rabin and
32805433/Universal-Group, under a fresh namespace to avoid conflicts.
Counts refer to displayed generator/relator slots, not minimality.
Uses Mathlib v4.35.0's `IsMulTorsionFree`, equivalent to absence of nontrivial torsion for groups.
-/
public section

namespace SmallPresentationStatements

/-- A generator index and sign: `true` is positive, `false` is inverse. -/
abbrev SignedGenerator (n : ℕ) := Fin n × Bool
abbrev Word (n : ℕ) := List (SignedGenerator n)

/-- A presentation with `n` generator slots and `m` possibly redundant relator slots. -/
structure FP (n m : ℕ) where
  relator : Fin m → Word n

namespace FP

variable {n m : ℕ}

def relSet (P : FP n m) : Set (FreeGroup (Fin n)) :=
  Set.range fun i ↦ FreeGroup.mk (P.relator i)

abbrev Group (P : FP n m) := PresentedGroup P.relSet

def wordProblem (P : FP n m) (w : Word n) : Prop :=
  PresentedGroup.mk P.relSet (FreeGroup.mk w) = 1

def presentsTrivial (P : FP n m) : Prop :=
  Subsingleton P.Group

/-- The relator words can be computed from the family index and relator index. -/
def Effective (A : ℕ → FP n m) : Prop :=
  Computable₂ fun j i ↦ (A j).relator i

/-- An effective family whose triviality problem is undecidable. -/
def IsAdianRabinFamily (A : ℕ → FP n m) : Prop :=
  Effective A ∧ ¬ ComputablePred fun j ↦ (A j).presentsTrivial

end FP

/-- Contains an isomorphic copy of every finitely presented group. -/
def IsUniversal (G : Type*) [Group G] : Prop :=
  ∀ (n m : ℕ) (Q : FP n m),
    ∃ f : Q.Group →* G, Function.Injective f

/-- One of the displayed generators normally generates the whole group. -/
def HasDisplayedNormalGenerator {n m : ℕ} (P : FP n m) : Prop :=
  ∃ k : Fin n,
    Subgroup.normalClosure
      ({PresentedGroup.of (rels := P.relSet) k} : Set P.Group) = ⊤

/-! ## Main statements -/

/-- There exists a universal group with a 2-generator, 3-relator presentation and infinite cyclic
abelianization, normally generated by one of its displayed generators. -/
theorem exists_two_three_universal_with_abelianization_Z :
    ∃ P : FP 2 3,
      IsUniversal P.Group ∧
      Nonempty (Abelianization P.Group ≃* Multiplicative ℤ) ∧
      HasDisplayedNormalGenerator P := by
  sorry

/-- There exists an effective family of 2-generator, 4-relator presentations with undecidable
triviality problem, such that every nontrivial presented group is universal. -/
theorem exists_two_four_universal_adian_rabin_family :
    ∃ A : ℕ → FP 2 4,
      FP.IsAdianRabinFamily A ∧
      ∀ j, ¬ (A j).presentsTrivial → IsUniversal (A j).Group := by
  sorry

/-! ## Further group-theoretic statement targets -/

/-- There exists a torsion-free group with a 2-generator, 4-relator presentation, undecidable word
problem, and infinite cyclic abelianization, normally generated by one of its displayed generators. -/
theorem exists_torsion_free_two_four_with_abelianization :
    ∃ P : FP 2 4,
      IsMulTorsionFree P.Group ∧
      ¬ ComputablePred P.wordProblem ∧
      Nonempty (Abelianization P.Group ≃* Multiplicative ℤ) ∧
      HasDisplayedNormalGenerator P := by
  sorry

/-- There exists an effective family of 2-generator, 5-relator presentations.
All presented groups are torsion-free, and no algorithm decides which are trivial. -/
theorem exists_torsion_free_two_five_adian_rabin_family :
    ∃ A : ℕ → FP 2 5,
      FP.IsAdianRabinFamily A ∧ ∀ j, IsMulTorsionFree (A j).Group := by
  sorry

end SmallPresentationStatements
