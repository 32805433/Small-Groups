module

public import SmallPresentation.SmallCancellationGeometryRibbonCounts
public import SmallPresentation.PermutationCycles

/-!
# Connected components of ribbon maps

Connectivity is generated by actual edge and vertex steps. In a connected map a two-corner
face using both sides of the same edge exhausts all darts. Consequently an inner two-corner
face, distinguished from an outside face, has two distinct edges and admits bigon suppression.
-/

@[expose] public section

namespace SmallPresentationStatements.RelativeSmallCancellation.Geometry.RibbonMap

variable {D : Type*} (P : RibbonMap D)

/-- A single edge or positive vertex step. -/
def Adjacent (d e : D) : Prop := P.edge d = e ∨ P.rotation d = e

/-- The equivalence relation generated by actual ribbon incidences. -/
def SameComponent : D → D → Prop := Relation.EqvGen P.Adjacent

/-- Every pair of darts belongs to the same component. -/
def Connected : Prop := ∀ d e, P.SameComponent d e

/-- Actual connected components, including no artificial component for an empty dart type. -/
abbrev Component := Quotient (Relation.EqvGen.setoid P.Adjacent)

theorem component_edge (d : D) : P.SameComponent d (P.edge d) :=
  Relation.EqvGen.rel _ _ (Or.inl rfl)

theorem component_rotation (d : D) : P.SameComponent d (P.rotation d) :=
  Relation.EqvGen.rel _ _ (Or.inr rfl)

theorem component_rotation_symm (d : D) : P.SameComponent d (P.rotation.symm d) := by
  have h := P.component_rotation (P.rotation.symm d)
  rw [Equiv.apply_symm_apply] at h
  exact Relation.EqvGen.symm _ _ h

theorem component_face (d : D) : P.SameComponent d (P.face d) :=
  Relation.EqvGen.trans _ _ _ (P.component_edge d) (P.component_rotation_symm (P.edge d))

/-- A map that sends each incidence to a path sends components to components. -/
theorem map_components {E : Type*} (Q : RibbonMap E) (f : D → E)
    (he : ∀ d, Q.SameComponent (f d) (f (P.edge d)))
    (hr : ∀ d, Q.SameComponent (f d) (f (P.rotation d)))
    {d e : D} (h : P.SameComponent d e) : Q.SameComponent (f d) (f e) := by
  induction h with
  | rel x y h =>
    rcases h with h | h
    · rw [← h]; exact he x
    · rw [← h]; exact hr x
  | refl x => exact Relation.EqvGen.refl _
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

theorem component_of_vertexCycle [Finite D] {d e : D}
    (h : P.rotation.SameCycle d e) : P.SameComponent d e := by
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  clear h
  induction n with
  | zero => exact Relation.EqvGen.refl d
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact Relation.EqvGen.trans _ _ _ ih (P.component_rotation _)

theorem component_of_faceCycle [Finite D] {d e : D}
    (h : P.face.SameCycle d e) : P.SameComponent d e := by
  obtain ⟨n, rfl⟩ := h.exists_nat_pow_eq
  clear h
  induction n with
  | zero => exact Relation.EqvGen.refl d
  | succ n ih =>
    rw [pow_succ', Equiv.Perm.mul_apply]
    exact Relation.EqvGen.trans _ _ _ ih (P.component_face _)

/-- A predicate invariant under both permutations is constant on connected components. -/
theorem invariant_on_component (p : D → Prop)
    (hedge : ∀ d, p (P.edge d) ↔ p d) (hrotation : ∀ d, p (P.rotation d) ↔ p d)
    {d e : D} (h : P.SameComponent d e) : p d ↔ p e := by
  induction h with
  | rel x y h =>
    rcases h with h | h
    · rw [← h]; exact (hedge x).symm
    · rw [← h]; exact (hrotation x).symm
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- An edge with a singleton vertex at each end forms an entire component. -/
theorem isolated_edge_component (d : D) (hd : P.rotation d = d)
    (he : P.rotation (P.edge d) = P.edge d) {x : D}
    (h : P.SameComponent d x) : x = d ∨ x = P.edge d := by
  apply (P.invariant_on_component (fun x ↦ x = d ∨ x = P.edge d) ?_ ?_ h).mp
    (Or.inl rfl)
  · intro x
    constructor
    · rintro (hx | hx)
      · right
        have hh := congrArg P.edge hx
        exact (P.edge_involutive x).symm.trans hh
      · left; exact P.edge.injective hx
    · rintro (rfl | rfl)
      · exact Or.inr rfl
      · exact Or.inl (P.edge_involutive d)
  · intro x
    constructor
    · rintro (hx | hx)
      · exact Or.inl (P.rotation.injective (hx.trans hd.symm))
      · exact Or.inr (P.rotation.injective (hx.trans he.symm))
    · rintro (rfl | rfl)
      · exact Or.inl hd
      · exact Or.inr he

/-- A connected two-sided face on one edge leaves no other face. -/
theorem same_edge_two_cycle_all_faces (hc : P.Connected) (d : D)
    (h₁ : P.face d = P.edge d) (h₂ : P.face (P.edge d) = d) (outside : D) :
    P.face.SameCycle outside d := by
  have hd : P.rotation d = d := by
    have h := congrArg P.rotation h₂
    change P.rotation (P.rotation.symm (P.edge (P.edge d))) = P.rotation d at h
    rw [Equiv.apply_symm_apply, P.edge_involutive d] at h
    exact h.symm
  have he : P.rotation (P.edge d) = P.edge d := by
    have h := congrArg P.rotation h₁
    simpa only [face_apply, Equiv.apply_symm_apply] using h.symm
  rcases P.isolated_edge_component d hd he (hc d outside) with ho | ho
  · rw [ho]
  · rw [ho, ← h₁]
    exact Equiv.Perm.sameCycle_apply_left.mpr (Equiv.Perm.SameCycle.refl _ _)

/-- An inner two-corner face in a connected ribbon uses distinct edges. -/
theorem inner_two_cycle_distinct_edges (hc : P.Connected) (outside d e : D)
    (h₁ : P.face d = e) (h₂ : P.face e = d)
    (hi : ¬ P.face.SameCycle outside d) : P.edge d ≠ e := by
  intro he
  apply hi
  exact P.same_edge_two_cycle_all_faces hc d (h₁.trans he.symm) (he ▸ h₂) outside

end SmallPresentationStatements.RelativeSmallCancellation.Geometry.RibbonMap
