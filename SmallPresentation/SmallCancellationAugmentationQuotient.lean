module

public import SmallPresentation.SmallCancellationAugmentation

/-!
# The quotient isomorphism for augmentation

For an arbitrary relator family in an indexed free product, adjoining free letters after
quotienting is canonically isomorphic to quotienting the augmented relator family. No
small-cancellation theorem or injectivity of the quotient's factor maps is used.
-/

@[expose] public section

namespace SmallPresentationStatements.RelativeSmallCancellation.Augmentation

variable {A I : Type} (G : A → Type) [∀ a, Group (G a)] (rel : I → Base G)

/-- Normal subgroup generated by the original relators. -/
def originalNormal : Subgroup (Base G) := Subgroup.normalClosure (Set.range rel)

instance originalNormal_normal : (originalNormal G rel).Normal := inferInstanceAs
  (Subgroup.normalClosure (Set.range rel)).Normal

/-- The original quotient. -/
abbrev OriginalQuotient := Base G ⧸ originalNormal G rel

/-- Normal subgroup generated by the augmented relators. -/
def augmentedNormal : Subgroup (Ambient G) :=
  Subgroup.normalClosure (Set.range (fun i ↦ augment G (rel i)))

instance augmentedNormal_normal : (augmentedNormal G rel).Normal := inferInstanceAs
  (Subgroup.normalClosure (Set.range (fun i ↦ augment G (rel i)))).Normal

/-- The quotient by the augmented presentation. -/
abbrev AugmentedQuotient := Ambient G ⧸ augmentedNormal G rel

/-- Adjoin the free auxiliary group to the original quotient. -/
abbrev QuotientWithLetters := Monoid.Coprod (OriginalQuotient G rel) (FreeGroup A)

/-- Quotient the original factor and leave the auxiliary group untouched. -/
def projection : Ambient G →* QuotientWithLetters G rel :=
  Monoid.Coprod.map (QuotientGroup.mk' (originalNormal G rel)) (MonoidHom.id _)

@[simp] theorem projection_base (g : Base G) :
    projection G rel (base G g) =
      Monoid.Coprod.inl (QuotientGroup.mk' (originalNormal G rel) g) := rfl

@[simp] theorem projection_letters (w : FreeGroup A) :
    projection G rel (letters G w) = Monoid.Coprod.inr w := rfl

theorem projection_surjective : Function.Surjective (projection G rel) := by
  intro z
  induction z using Monoid.Coprod.induction_on with
  | inl g =>
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (originalNormal G rel) g
    exact ⟨base G g, rfl⟩
  | inr w => exact ⟨letters G w, rfl⟩
  | mul x y hx hy =>
    obtain ⟨x, rfl⟩ := hx
    obtain ⟨y, rfl⟩ := hy
    exact ⟨x * y, (projection G rel).map_mul x y⟩

/-- Original words interpreted in the augmented quotient after substitution. -/
def toAugmentedBase : Base G →* AugmentedQuotient G rel :=
  (QuotientGroup.mk' (augmentedNormal G rel)).comp (conjugatedBase G false)

theorem originalNormal_le_toAugmentedBase_ker :
    originalNormal G rel ≤ (toAugmentedBase G rel).ker := by
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨i, rfl⟩
  change QuotientGroup.mk' (augmentedNormal G rel) (augment G (rel i)) = 1
  exact (QuotientGroup.eq_one_iff _).mpr (Subgroup.subset_normalClosure ⟨i, rfl⟩)

/-- The original quotient maps into the augmented quotient. -/
def toAugmentedOriginal : OriginalQuotient G rel →* AugmentedQuotient G rel :=
  QuotientGroup.lift (originalNormal G rel) (toAugmentedBase G rel)
    (originalNormal_le_toAugmentedBase_ker G rel)

/-- The forward map of the augmentation quotient isomorphism. -/
def toAugmented : QuotientWithLetters G rel →* AugmentedQuotient G rel :=
  Monoid.Coprod.lift (toAugmentedOriginal G rel)
    ((QuotientGroup.mk' (augmentedNormal G rel)).comp (letters G))

@[simp] theorem toAugmented_projection (z : Ambient G) :
    toAugmented G rel (projection G rel z) =
      QuotientGroup.mk' (augmentedNormal G rel) (equiv G z) := by
  have h : (toAugmented G rel).comp (projection G rel) =
      (QuotientGroup.mk' (augmentedNormal G rel)).comp (equiv G).toMonoidHom := by
    apply Monoid.Coprod.hom_ext
    · apply MonoidHom.ext
      intro g
      change toAugmentedOriginal G rel (QuotientGroup.mk' (originalNormal G rel) g) = _
      rfl
    · apply MonoidHom.ext
      intro w
      change QuotientGroup.mk' (augmentedNormal G rel) (letters G w) =
        QuotientGroup.mk' (augmentedNormal G rel) (equiv G (letters G w))
      rw [equiv_letters]
  exact DFunLike.congr_fun h z

/-- Undo the substitution before taking the quotient of the original factor. -/
def fromAugmentedAmbient : Ambient G →* QuotientWithLetters G rel :=
  (projection G rel).comp (equiv G).symm.toMonoidHom

theorem augmentedNormal_le_fromAugmentedAmbient_ker :
    augmentedNormal G rel ≤ (fromAugmentedAmbient G rel).ker := by
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨i, rfl⟩
  change projection G rel ((equiv G).symm (equiv G (base G (rel i)))) = 1
  rw [MulEquiv.symm_apply_apply, projection_base]
  have h : QuotientGroup.mk' (originalNormal G rel) (rel i) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr (Subgroup.subset_normalClosure ⟨i, rfl⟩)
  rw [h, map_one]

/-- The inverse map from the augmented quotient. -/
def fromAugmented : AugmentedQuotient G rel →* QuotientWithLetters G rel :=
  QuotientGroup.lift (augmentedNormal G rel) (fromAugmentedAmbient G rel)
    (augmentedNormal_le_fromAugmentedAmbient_ker G rel)

@[simp] theorem fromAugmented_mk (z : Ambient G) :
    fromAugmented G rel (QuotientGroup.mk' (augmentedNormal G rel) z) =
      projection G rel ((equiv G).symm z) := rfl

theorem fromAugmented_comp_toAugmented :
    (fromAugmented G rel).comp (toAugmented G rel) = MonoidHom.id _ := by
  apply MonoidHom.ext
  intro z
  obtain ⟨z, rfl⟩ := projection_surjective G rel z
  change fromAugmented G rel (toAugmented G rel (projection G rel z)) = projection G rel z
  rw [toAugmented_projection, fromAugmented_mk, MulEquiv.symm_apply_apply]

theorem toAugmented_comp_fromAugmented :
    (toAugmented G rel).comp (fromAugmented G rel) = MonoidHom.id _ := by
  apply MonoidHom.ext
  intro z
  obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective (augmentedNormal G rel) z
  change toAugmented G rel (fromAugmented G rel
    (QuotientGroup.mk' (augmentedNormal G rel) z)) = _
  rw [fromAugmented_mk, toAugmented_projection, MulEquiv.apply_symm_apply]
  rfl

/-- The actual canonical isomorphism `Q * Free(A) ≃ Q_aug`. -/
def quotientEquiv : QuotientWithLetters G rel ≃* AugmentedQuotient G rel :=
  (toAugmented G rel).toMulEquiv (fromAugmented G rel)
    (fromAugmented_comp_toAugmented G rel) (toAugmented_comp_fromAugmented G rel)

@[simp] theorem quotientEquiv_projection (z : Ambient G) :
    quotientEquiv G rel (projection G rel z) =
      QuotientGroup.mk' (augmentedNormal G rel) (equiv G z) :=
  toAugmented_projection G rel z

@[simp] theorem quotientEquiv_factor (a : A) (g : G a) :
    quotientEquiv G rel
      (Monoid.Coprod.inl (QuotientGroup.mk' (originalNormal G rel) (Monoid.CoprodI.of g))) =
    QuotientGroup.mk' (augmentedNormal G rel) (letter G a) *
      QuotientGroup.mk' (augmentedNormal G rel) (factor G a g) *
      (QuotientGroup.mk' (augmentedNormal G rel) (letter G a))⁻¹ := by
  change quotientEquiv G rel (projection G rel (factor G a g)) = _
  rw [quotientEquiv_projection, equiv_factor, map_mul, map_mul, map_inv]

@[simp] theorem quotientEquiv_letters (w : FreeGroup A) :
    quotientEquiv G rel (Monoid.Coprod.inr w) =
      QuotientGroup.mk' (augmentedNormal G rel) (letters G w) := by
  change quotientEquiv G rel (projection G rel (letters G w)) = _
  rw [quotientEquiv_projection, equiv_letters]

/-- The coefficient copy of the original free product in the augmented quotient. -/
def coefficient : Base G →* AugmentedQuotient G rel :=
  (QuotientGroup.mk' (augmentedNormal G rel)).comp (base G)

/-- Coefficient injection for the augmented presentation gives every original factor embedding.
This implication uses only the explicit augmentation isomorphism, not small cancellation. -/
theorem factor_injective_of_coefficient_injective
    (h : Function.Injective (coefficient G rel)) (a : A) :
    Function.Injective
      ((QuotientGroup.mk' (originalNormal G rel)).comp (Monoid.CoprodI.of : G a →* _)) := by
  intro g k hgk
  apply Monoid.CoprodI.of_injective a
  apply h
  change QuotientGroup.mk' (augmentedNormal G rel) (factor G a g) =
    QuotientGroup.mk' (augmentedNormal G rel) (factor G a k)
  have he := congrArg (fun z : OriginalQuotient G rel ↦
    quotientEquiv G rel (Monoid.Coprod.inl z)) hgk
  change quotientEquiv G rel
      (Monoid.Coprod.inl (QuotientGroup.mk' (originalNormal G rel) (Monoid.CoprodI.of g))) =
    quotientEquiv G rel
      (Monoid.Coprod.inl (QuotientGroup.mk' (originalNormal G rel) (Monoid.CoprodI.of k))) at he
  rw [quotientEquiv_factor, quotientEquiv_factor] at he
  exact mul_left_cancel (mul_right_cancel he)

end SmallPresentationStatements.RelativeSmallCancellation.Augmentation
