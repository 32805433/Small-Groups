module

public import Mathlib.GroupTheory.FreeGroup.NielsenSchreier
public import Mathlib.GroupTheory.FreeGroup.CyclicallyReduced
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-! Common roots for commuting elements of free groups. The proof uses
Nielsen--Schreier: the subgroup generated by two commuting elements is both free
and abelian, hence cyclic. This avoids any assumptions about a chosen word basis. -/
@[expose] public section

namespace SmallPresentationStatements.FreeGroupCentralizer

open scoped IsMulCommutative

/-- Distinct free generators do not commute. -/
theorem generators_eq_of_commute {X : Type*} (a b : X)
    (h : Commute (FreeGroup.of a) (FreeGroup.of b)) : a = b := by
  classical
  have hh := congrArg FreeGroup.toWord h.eq
  exact (show a = b ∧ b = a by
    simpa [FreeGroup.toWord_mul, FreeGroup.reduce] using hh).1

/-- A free group on at most one generator is cyclic, including the empty case. -/
theorem freeGroup_isCyclic_of_subsingleton (X : Type*) [Subsingleton X] :
    IsCyclic (FreeGroup X) := by
  classical
  cases isEmpty_or_nonempty X with
  | inl h =>
    let := h
    have he (w : FreeGroup X) : w = 1 := by
      induction w using FreeGroup.induction_on with
      | one => rfl
      | of x => exact isEmptyElim x
      | inv_of x _ => exact isEmptyElim x
      | mul _ _ ih ih' => simp [ih, ih']
    exact ⟨1, fun w ↦ ⟨0, by simp [he w]⟩⟩
  | inr h =>
    let : Unique X := ⟨⟨Classical.choice h⟩, fun _ ↦ Subsingleton.elim _ _⟩
    infer_instance

/-- Every abelian free group is cyclic. -/
theorem isCyclic_of_commutative (G : Type*) [Group G] [IsFreeGroup G]
    [IsMulCommutative G] : IsCyclic G := by
  classical
  let e := IsFreeGroup.mulEquiv G
  have hsub : Subsingleton (IsFreeGroup.Generators G) := by
    constructor
    intro a b
    apply generators_eq_of_commute a b
    change FreeGroup.of a * FreeGroup.of b = FreeGroup.of b * FreeGroup.of a
    apply e.injective
    simp only [map_mul]
    exact mul_comm _ _
  let := hsub
  let := freeGroup_isCyclic_of_subsingleton (IsFreeGroup.Generators G)
  exact isCyclic_of_surjective e e.surjective

variable {G : Type*} [Group G] [IsFreeGroup G]

/-- The subgroup generated by a commuting pair in a free group is cyclic. -/
theorem pair_closure_isCyclic (x y : G) (hxy : Commute x y) :
    IsCyclic (Subgroup.closure ({x, y} : Set G)) := by
  have hcomm : ({x, y} : Set G).Pairwise Commute := by
    intro a ha b hb _
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    all_goals first | exact Commute.refl _ | exact hxy | exact hxy.symm
  let := Subgroup.isMulCommutative_closure hcomm
  exact isCyclic_of_commutative _

/-- Any two commuting elements of a free group are integral powers of one element. -/
theorem exists_common_zpow (x y : G) (hxy : Commute x y) :
    ∃ z : G, ∃ m n : ℤ, z ^ m = x ∧ z ^ n = y := by
  let H := Subgroup.closure ({x, y} : Set G)
  let : IsCyclic H := pair_closure_isCyclic x y hxy
  obtain ⟨z, hz⟩ := exists_zpow_surjective H
  obtain ⟨m, hm⟩ := hz ⟨x, Subgroup.subset_closure (by simp)⟩
  obtain ⟨n, hn⟩ := hz ⟨y, Subgroup.subset_closure (by simp)⟩
  exact ⟨z.val, m, n, congrArg Subtype.val hm, congrArg Subtype.val hn⟩

/-- Any group with a free basis has unique roots, independently of its presentation. -/
theorem hasUniqueRoots_of_isFree (H : Type*) [Group H] [IsFreeGroup H] : HasUniqueRoots H where
  pow_left_injective n hn x y h := by
    apply (IsFreeGroup.toFreeGroup H).injective
    apply pow_left_injective hn
    simpa only [← map_pow] using congrArg (IsFreeGroup.toFreeGroup H) h

/-- In a group with unique roots, commuting with a nonzero integral power
already means commuting with its root. -/
theorem commute_of_zpow_commute {H : Type*} [Group H] [HasUniqueRoots H]
    (x y : H) (n : ℤ) (hn : n ≠ 0) (h : Commute (x ^ n) y) : Commute x y := by
  have hc : MulAut.conj y (x ^ n) = x ^ n := by
    change y * x ^ n * y⁻¹ = x ^ n
    rw [← h.eq, mul_assoc, mul_inv_cancel, mul_one]
  have hx : MulAut.conj y x = x := zpow_left_injective hn (by
    simpa only [map_zpow] using hc)
  change x * y = y * x
  have hh := congrArg (fun t : H ↦ t * y) hx
  simpa only [MulAut.conj_apply, mul_assoc, inv_mul_cancel, mul_one] using hh.symm

/-- The centralizer of every nonidentity element of a free group is cyclic. -/
theorem centralizer_isCyclic (r : G) (hr : r ≠ 1) :
    IsCyclic (Subgroup.centralizer ({r} : Set G)) := by
  let := hasUniqueRoots_of_isFree G
  have hc (x y : Subgroup.centralizer ({r} : Set G)) : x * y = y * x := by
    apply Subtype.ext
    have hx : Commute x.val r := Subgroup.mem_centralizer_singleton_iff.mp x.property
    have hy : Commute y.val r := Subgroup.mem_centralizer_singleton_iff.mp y.property
    obtain ⟨z, m, n, hm, hn⟩ := exists_common_zpow x.val r hx
    have hn0 : n ≠ 0 := by
      intro he
      apply hr
      simpa only [he, zpow_zero] using hn.symm
    have hz : Commute (z ^ n) y.val := hn.symm ▸ hy.symm
    have hzy := commute_of_zpow_commute z y.val n hn0 hz
    change x.val * y.val = y.val * x.val
    simpa only [hm] using (hzy.zpow_left m).eq
  let : IsMulCommutative (Subgroup.centralizer ({r} : Set G)) := ⟨⟨hc⟩⟩
  exact isCyclic_of_commutative _

/-- A group with unique square roots has no nonidentity element conjugate to its inverse. -/
theorem eq_one_of_conjugate_eq_inv {H : Type*} [Group H] [HasUniqueRoots H]
    (w r : H) (h : w * r * w⁻¹ = r⁻¹) : r = 1 := by
  have hwr : w * r = r⁻¹ * w := (mul_inv_eq_iff_eq_mul).mp h
  have hs : (r * w) ^ 2 = w ^ 2 := by
    calc
      (r * w) ^ 2 = r * (w * r) * w := by simp [pow_two, mul_assoc]
      _ = r * (r⁻¹ * w) * w := by rw [hwr]
      _ = w ^ 2 := by simp [pow_two]
  have he : r * w = w := pow_left_injective (by decide : 2 ≠ 0) hs
  exact mul_right_cancel (he.trans (one_mul w).symm)

/-- No nonidentity element of a free group is conjugate to its inverse. -/
theorem conjugate_ne_inv (r : G) (hr : r ≠ 1) (w : G) : w * r * w⁻¹ ≠ r⁻¹ := by
  let := hasUniqueRoots_of_isFree G
  exact fun h ↦ hr (eq_one_of_conjugate_eq_inv w r h)

end SmallPresentationStatements.FreeGroupCentralizer
