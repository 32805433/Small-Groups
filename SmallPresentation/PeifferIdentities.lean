module

public import SmallPresentation.WeightedIdentitySequences
public import Mathlib.Tactic.Abel

/-!
# Finite identities, Peiffer moves, and weighted invariants

Relator occurrences retain their conjugator, label, and sign. The elementary
exchange and cancellation moves preserve the evaluated product. If the quotient
kills the relators, these moves also preserve the quotient-weighted coordinates.
-/
@[expose] public section

namespace SmallPresentationStatements.RelationCoordinates.Peiffer

variable {F Q I J : Type} [Group F] [Group Q]
    (rel : I → F) (q : F →* Q) (label : I → Option J)

abbrev Occurrence (F I : Type) := (F × I) × Bool
abbrev Sequence (F I : Type) := List (Occurrence F I)

/-- The value of one signed conjugated-relator occurrence. -/
def term (a : Occurrence F I) : F :=
  bif a.2 then a.1.1 * rel a.1.2 * a.1.1⁻¹ else (a.1.1 * rel a.1.2 * a.1.1⁻¹)⁻¹

/-- The selected quotient-weighted contribution of one occurrence. -/
def weight (a : Occurrence F I) : Weighted.Coordinates (Q := Q) (J := J) :=
  bif a.2 then Weighted.generator label (q a.1.1) a.1.2
  else -Weighted.generator label (q a.1.1) a.1.2

/-- The ordered product of all relator occurrences. -/
def evaluation (s : Sequence F I) : F := (s.map (term rel)).prod

/-- The sum of all selected quotient-weighted occurrences. -/
def weights (s : Sequence F I) : Weighted.Coordinates (Q := Q) (J := J) :=
  (s.map (weight q label)).sum

/-- Reverse the sign without changing the relator or its conjugator. -/
def inverse (a : Occurrence F I) : Occurrence F I := (a.1, !a.2)

/-- The conjugated second term in the elementary Peiffer exchange. -/
def exchange (a b : Occurrence F I) : Occurrence F I :=
  ((term rel a * b.1.1, b.1.2), b.2)

@[simp] theorem term_inverse (a : Occurrence F I) : term rel (inverse a) = (term rel a)⁻¹ := by
  rcases a with ⟨⟨f, i⟩, b⟩
  cases b <;> simp [inverse, term]

@[simp] theorem weight_inverse (a : Occurrence F I) : weight q label (inverse a) = -weight q label a := by
  rcases a with ⟨⟨f, i⟩, b⟩
  cases b <;> simp [inverse, weight]

theorem term_exchange (a b : Occurrence F I) :
    term rel (exchange rel a b) = term rel a * term rel b * (term rel a)⁻¹ := by
  rcases a with ⟨⟨f, j⟩, a⟩
  rcases b with ⟨⟨g, i⟩, b⟩
  cases a <;> cases b <;> simp [exchange, term] <;> group

/-- Every occurrence dies in a quotient that kills the attaching relators. -/
theorem quotient_term (hkill : ∀ i, q (rel i) = 1) (a : Occurrence F I) :
    q (term rel a) = 1 := by
  rcases a with ⟨⟨f, i⟩, b⟩
  cases b <;> simp [term, hkill]

theorem weight_exchange (hkill : ∀ i, q (rel i) = 1) (a b : Occurrence F I) :
    weight q label (exchange rel a b) = weight q label b := by
  have hq := quotient_term rel q hkill a
  rcases b with ⟨⟨g, i⟩, b⟩
  cases b <;> simp [weight, exchange, map_mul, hq]

@[simp] theorem evaluation_append (s t : Sequence F I) :
    evaluation rel (s ++ t) = evaluation rel s * evaluation rel t := by
  simp [evaluation]

@[simp] theorem weights_append (s t : Sequence F I) :
    weights q label (s ++ t) = weights q label s + weights q label t := by
  simp [weights]

/-- The equivalence generated by elementary Peiffer exchanges and inverse-pair deletion. -/
inductive Equiv : Sequence F I → Sequence F I → Prop
  | refl (s) : Equiv s s
  | symm {s t} : Equiv s t → Equiv t s
  | trans {s t u} : Equiv s t → Equiv t u → Equiv s u
  | exchange (s t : Sequence F I) (a b : Occurrence F I) :
      Equiv (s ++ a :: b :: t) (s ++ exchange rel a b :: a :: t)
  | cancel (s t : Sequence F I) (a : Occurrence F I) :
      Equiv (s ++ a :: inverse a :: t) (s ++ t)

/-- Each finite sequence of elementary moves preserves its actual group value. -/
theorem evaluation_equiv {s t : Sequence F I} (h : Equiv rel s t) :
    evaluation rel s = evaluation rel t := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | exchange s t a b =>
    simp only [evaluation, List.map_append, List.prod_append, List.map_cons, List.prod_cons]
    rw [term_exchange]
    group
  | cancel s t a =>
    simp [evaluation, List.prod_append, term_inverse]

/-- The coefficient retained by a new relator is invariant under every Peiffer move. -/
theorem weights_equiv (hkill : ∀ i, q (rel i) = 1) {s t : Sequence F I}
    (h : Equiv rel s t) : weights q label s = weights q label t := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | exchange s t a b =>
    simp only [weights, List.map_append, List.sum_append, List.map_cons, List.sum_cons]
    rw [weight_exchange rel q label hkill]
    abel
  | cancel s t a =>
    simp [weights, List.sum_append, weight_inverse]

/-- A sequence of only unselected relators has zero selected coordinate. -/
theorem weights_eq_zero_of_unselected (s : Sequence F I)
    (h : ∀ a ∈ s, label a.1.2 = none) : weights q label s = 0 := by
  apply List.sum_eq_zero
  intro x hx
  obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
  rcases a with ⟨⟨f, i⟩, b⟩
  have hi := h ((f, i), b) ha
  cases b <;> simp [weight, Weighted.generator, hi]

/-- Sequence evaluation agrees with the original free-group encoding of identity sequences. -/
theorem evaluation_mk (s : Sequence F I) :
    conjugateEvaluation rel (FreeGroup.mk s) = evaluation rel s := by
  simp only [conjugateEvaluation, FreeGroup.lift_mk, evaluation]
  rfl

/-- The list-based invariant agrees with the quotient-weighted free-group homomorphism. -/
theorem vector_mk (s : Sequence F I) :
    (Weighted.vector q label (FreeGroup.mk s)).toAdd = weights q label s := by
  induction s with
  | nil => simp [Weighted.vector, weights]
  | cons a s ih =>
    rcases a with ⟨⟨f, i⟩, b⟩
    cases b <;>
      simpa [Weighted.vector, FreeGroup.lift_mk, weights, weight] using ih

/-- Reduction of all evaluated identity sequences to unselected relators gives
weighted identity vanishing. The geometric reduction itself is a separate hypothesis. -/
theorem balanced_of_reduction (hkill : ∀ i, q (rel i) = 1)
    (hreduce : ∀ s : Sequence F I, evaluation rel s = 1 →
      ∃ t, Equiv rel s t ∧ ∀ a ∈ t, label a.1.2 = none) :
    Weighted.Balanced rel q label := by
  intro w hw
  induction w using Quot.inductionOn with
  | h s =>
    obtain ⟨t, ht, hold⟩ := hreduce s ((evaluation_mk rel s).symm.trans hw)
    change Weighted.vector q label (FreeGroup.mk s) = 1
    apply Multiplicative.toAdd.injective
    rw [vector_mk, weights_equiv rel q label hkill ht,
      weights_eq_zero_of_unselected q label t hold]
    rfl

end SmallPresentationStatements.RelationCoordinates.Peiffer
