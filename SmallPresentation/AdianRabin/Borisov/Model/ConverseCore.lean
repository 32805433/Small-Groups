namespace UniversalGroup
namespace BorisovDoubleCosetBridge

open HNNLemmas

variable {G : Type*} [Group G]

theorem inverse_commutator_eq_one_iff_commute (a b : G) :
    a⁻¹ * b⁻¹ * a * b = 1 ↔ Commute a b := by
  simpa only [commutatorElement_def, inv_inv, Commute.inv_inv_iff] using
    (commutatorElement_eq_one_iff_commute (g₁ := a⁻¹) (g₂ := b⁻¹))

/-- Sharp form of the last two HNN reductions in Borisov's converse.

The last stable letter `k` centralizes the subgroup generated by the image of
`A` and `P⁻¹tP`.  If `Q⁻¹tQ` commutes with `k`, comparison of the first
stable-letter coefficient gives the ordered double-coset equation
`P = c * Q * a`, with `c ∈ C` and `a ∈ A`. -/
theorem lastTwoStages_force_doubleCoset
    (A C : Subgroup G) (P Q : G)
    (hcomm : Commute
      (centralizerOf
        (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P))
        (conjugatedStable C Q))
      (centralizerStable
        (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P)))) :
    ∃ c : C, ∃ a : A, P = (c : G) * Q * (a : G) := by
  let K : Subgroup (CentralizerHNN G C) :=
    generatedWith (A.map (centralizerOf C)) (conjugatedStable C P)
  have hmem : conjugatedStable C Q ∈ K :=
    (centralizerOf_commute_stable_iff K (conjugatedStable C Q)).mp (by
      simpa [K] using hcomm)
  exact conjugatedStable_mem_generatedWith_imp_doubleCoset A C P Q hmem

/-- The same result for the commutator convention used by `Borisov.testWord`.
-/
theorem lastTwoStages_force_doubleCoset_of_commutator
    (A C : Subgroup G) (P Q : G)
    (hcommutator :
      (centralizerOf
          (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P))
          (conjugatedStable C Q))⁻¹ *
        (centralizerStable
          (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P)))⁻¹ *
        centralizerOf
          (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P))
          (conjugatedStable C Q) *
        centralizerStable
          (generatedWith (A.map (centralizerOf C)) (conjugatedStable C P)) = 1) :
    ∃ c : C, ∃ a : A, P = (c : G) * Q * (a : G) := by
  apply lastTwoStages_force_doubleCoset A C P Q
  exact (inverse_commutator_eq_one_iff_commute _ _).mp hcommutator

end BorisovDoubleCosetBridge
end UniversalGroup

namespace UniversalGroup
namespace BorisovConverseCore

open HNNLemmas
open BorisovCStage
open BorisovContextNormalForm
open BorisovDoubleCosetBridge

noncomputable section

/-- The `t`-stage of Borisov's model, with `t` centralizing `<c,d>`. -/
abbrev TStage (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :=
  CentralizerHNN (Gamma2 datum hfree) (CD datum hfree)

def toTStage (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :
    Gamma2 datum hfree →* TStage datum hfree :=
  centralizerOf (CD datum hfree)

def tLetter (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :
    TStage datum hfree :=
  centralizerStable (CD datum hfree)

def conjugatedT (datum : Thue.StandingDatum) (hfree : RankFiveFree datum)
    (w : List (Fin 2)) : TStage datum hfree :=
  conjugatedStable (CD datum hfree) (positive2 datum hfree w)

/-- The subgroup centralized by Borisov's final letter `k`. -/
def KSubgroup (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :
    Subgroup (TStage datum hfree) :=
  generatedWith
    ((CE datum hfree).map (toTStage datum hfree))
    (conjugatedT datum hfree datum.P)

/-- The final `k`-stage of the semantic HNN model. -/
abbrev FinalStage (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :=
  CentralizerHNN (TStage datum hfree) (KSubgroup datum hfree)

def toFinalStage (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :
    TStage datum hfree →* FinalStage datum hfree :=
  centralizerOf (KSubgroup datum hfree)

def finalConjugatedT (datum : Thue.StandingDatum)
    (hfree : RankFiveFree datum) (w : List (Fin 2)) :
    FinalStage datum hfree :=
  toFinalStage datum hfree (conjugatedT datum hfree w)

def kLetter (datum : Thue.StandingDatum) (hfree : RankFiveFree datum) :
    FinalStage datum hfree :=
  centralizerStable (KSubgroup datum hfree)

/-- The simulator and the fixed Thue system use opposite orientations of the same
symmetric rules. This converts the shared recognition conclusion to the fixed interface. -/
theorem thueEq_of_supportedRules_positiveEq (R : SupportedRules)
    {u v : PositiveWord} (h : PositiveEq R.rules u v) :
    ThueEq (Thue.systemOf R.F R.E) u v := by
  apply Relation.ReflTransGen.mono (r := PositiveStep R.rules) _ u v h
  intro a b hab
  rcases hab with ⟨l, r, x, y, ⟨i, hxy⟩, hab⟩
  injection hxy with hx hy
  subst x
  subst y
  refine ⟨l, r, R.F i, R.E i, ⟨i, rfl⟩, ?_⟩
  exact hab.elim Or.inr Or.inl

/-- Ordered double-coset factorization in the `c`-stage produces the exact
irreducible equation consumed by Borisov's Lemma 4. -/
theorem thueEq_of_context_factorization
    (datum : Thue.StandingDatum) (hfree : RankFiveFree datum)
    (hinter : BaseIntersections datum)
    (hlemma4 : BorisovLemma4 datum hfree)
    (Q : List (Fin 2))
    (hfactor : ∃ l : CD datum hfree, ∃ r : CE datum hfree,
      positive2 datum hfree datum.P =
        (l : Gamma2 datum hfree) * positive2 datum hfree Q *
          (r : Gamma2 datum hfree)) :
    ThueEq (Thue.systemOf datum.F datum.E) Q datum.P := by
  rcases hfactor with ⟨l, r, hfactor⟩
  rcases exists_leftContext_of_mem_CD datum hfree hinter l.property with
    ⟨L, hL⟩
  rcases exists_rightContext_of_mem_CE datum hfree hinter r.property with
    ⟨R, hR⟩
  have hs : sLift2 datum hfree (positiveFree datum.P) =
      positive2 datum hfree datum.P := by
    simp [sLift2, positive2, sLift3, positiveFree, FreeGroup.lift_mk,
      positive3, UniversalGroup.evalPositive, stable3, Function.comp_def]
  have heq : Lemma4Equation datum hfree (positiveFree datum.P) Q L R := by
    unfold Lemma4Equation
    rw [hs]
    apply (equation_iff_factorization _ _ _ _).mpr
    simpa [hL, hR] using hfactor
  obtain ⟨P, hP, hQP⟩ := hlemma4 (positiveFree datum.P) Q L R heq
  have hP' := positiveFree_injective hP
  subst P
  exact thueEq_of_supportedRules_positiveEq datum hQP

/-- Fully formal last-two-stage implication.  Once Assertions IV--V provide
the base intersections and the local Lemma-4 induction, triviality of the
test commutator in the semantic HNN model implies the desired Thue equality.
-/
theorem model_test_eq_one_imp_thueEq
    (datum : Thue.StandingDatum) (hfree : RankFiveFree datum)
    (hinter : BaseIntersections datum)
    (hlemma4 : BorisovLemma4 datum hfree)
    (Q : List (Fin 2))
    (htest :
      (finalConjugatedT datum hfree Q)⁻¹ *
          (kLetter datum hfree)⁻¹ *
          finalConjugatedT datum hfree Q * kLetter datum hfree = 1) :
    ThueEq (Thue.systemOf datum.F datum.E) Q datum.P := by
  apply thueEq_of_context_factorization datum hfree hinter hlemma4 Q
  exact lastTwoStages_force_doubleCoset_of_commutator
    (CE datum hfree) (CD datum hfree)
    (positive2 datum hfree datum.P) (positive2 datum hfree Q) (by
      change
        (centralizerOf (KSubgroup datum hfree)
          (conjugatedStable (CD datum hfree)
            (positive2 datum hfree Q)))⁻¹ *
          (centralizerStable (KSubgroup datum hfree))⁻¹ *
          centralizerOf (KSubgroup datum hfree)
            (conjugatedStable (CD datum hfree)
              (positive2 datum hfree Q)) *
          centralizerStable (KSubgroup datum hfree) = 1 at htest
      exact htest)

end

