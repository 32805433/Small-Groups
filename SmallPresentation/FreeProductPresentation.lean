module

public import SmallPresentation.FreeProductHomology
public import SmallPresentation.HopfNaturality
public import SmallPresentation.RelationCoordinates

/-! The disjoint-union free presentation of an arbitrary indexed free product.
Its defining kernel is exactly the normal closure of the factor presentation kernels. -/
@[expose] public section

namespace SmallPresentationStatements.Homology.FreeProductPresentation

open RelationExtension
open DirectSum
attribute [local instance] Classical.propDecidable

variable {A : Type} (G : A → Type) [∀ a, Group (G a)]

abbrev Free := FreeGroup (Σ a, G a)

def factor (a : A) : FreeGroup (G a) →* Free G := FreeGroup.map (Sigma.mk a)

def projection : Free G →* Monoid.CoprodI G :=
  FreeGroup.lift (fun x : Σ a, G a ↦ Monoid.CoprodI.of x.2)

abbrev Relations := (projection G).ker

theorem projection_factor (a : A) : (projection G).comp (factor G a) =
    (Monoid.CoprodI.of : G a →* _).comp (freeProjection (G a)) := by
  apply FreeGroup.ext_hom
  intro x
  simp [projection, factor, freeProjection]

theorem factor_relations (a : A) : canonicalRelations (G a) ≤
    (Relations G).comap (factor G a) := by
  intro x hx
  change projection G (factor G a x) = 1
  rw [← MonoidHom.comp_apply, projection_factor, MonoidHom.comp_apply,
    show freeProjection (G a) x = 1 from hx, map_one]

theorem projection_surjective : Function.Surjective (projection G) := by
  intro x
  induction x using Monoid.CoprodI.induction_on with
  | one => exact ⟨1, map_one _⟩
  | of a g => exact ⟨FreeGroup.of ⟨a, g⟩, FreeGroup.lift_apply_of⟩
  | mul x y hx hy =>
    obtain ⟨u, rfl⟩ := hx
    obtain ⟨v, rfl⟩ := hy
    exact ⟨u * v, map_mul _ _ _⟩

/-- Factor relators as literal elements of the disjoint-union free group. -/
def relation (x : Σ a, canonicalRelations (G a)) : Free G := factor G x.1 x.2.val

/-- The kernel of the disjoint-union presentation is normally generated by the
relations of the individual factors. -/
theorem relations_eq_normalClosure : Relations G =
    Subgroup.normalClosure (Set.range (relation G)) := by
  let N := Subgroup.normalClosure (Set.range (relation G))
  have hsub : N ≤ Relations G := by
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨⟨a, r⟩, rfl⟩
    exact factor_relations G a r.property
  let q := QuotientGroup.mk' N
  have hlift (a : A) : canonicalRelations (G a) ≤ (q.comp (factor G a)).ker := by
    intro r hr
    apply (QuotientGroup.eq_one_iff _).mpr
    exact Subgroup.subset_normalClosure ⟨⟨a, ⟨r, hr⟩⟩, rfl⟩
  let liftFactor (a : A) : G a →* Free G ⧸ N :=
    (freeProjection (G a)).liftOfSurjective
      (fun x ↦ ⟨FreeGroup.of x, FreeGroup.lift_apply_of⟩) ⟨q.comp (factor G a), hlift a⟩
  have hlift_eq (a : A) (w : FreeGroup (G a)) :
      liftFactor a (freeProjection (G a) w) = q (factor G a w) :=
    MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _
  let inverse : Monoid.CoprodI G →* Free G ⧸ N := Monoid.CoprodI.lift liftFactor
  have heq : inverse.comp (projection G) = q := by
    apply FreeGroup.ext_hom
    rintro ⟨a, g⟩
    change inverse (projection G (FreeGroup.of ⟨a, g⟩)) = q (FreeGroup.of ⟨a, g⟩)
    rw [show projection G (FreeGroup.of ⟨a, g⟩) = Monoid.CoprodI.of g from
      FreeGroup.lift_apply_of]
    change liftFactor a g = q (FreeGroup.of ⟨a, g⟩)
    simpa [freeProjection, factor] using hlift_eq a (FreeGroup.of g)
  apply le_antisymm _ hsub
  intro w hw
  apply (QuotientGroup.eq_one_iff w).mp
  change q w = 1
  rw [← DFunLike.congr_fun heq w]
  change inverse (projection G w) = 1
  rw [show projection G w = 1 from hw, map_one]

/-- The inclusion of a factor's central relation extension. -/
def factorTotal (a : A) : Total (canonicalRelations (G a)) →* Total (Relations G) :=
  totalMap _ _ (factor G a) (factor_relations G a)

/-- The inclusion of a factor's central relation kernel. -/
def factorKernel (a : A) : Kernel (canonicalRelations (G a)) →* Kernel (Relations G) :=
  ((factorTotal G a).comp (Kernel (canonicalRelations (G a))).subtype).codRestrict _ (by
    intro x
    change RelationExtension.projection (Relations G) (factorTotal G a x.val) = 1
    rw [factorTotal, totalMap_projection,
      show RelationExtension.projection (canonicalRelations (G a)) x.val = 1 from x.property,
      map_one])

/-- All factor relation kernels together generate the total relation kernel. -/
noncomputable def relationSum :
    (⨁ a, Additive (Kernel (canonicalRelations (G a)))) →+ Additive (Kernel (Relations G)) :=
  DirectSum.toAddMonoid (fun a ↦ (factorKernel G a).toAdditive)

@[simp] theorem relationSum_of (a : A) (x : Additive (Kernel (canonicalRelations (G a)))) :
    relationSum G (DirectSum.of (fun a ↦ Additive (Kernel (canonicalRelations (G a)))) a x) =
      (factorKernel G a).toAdditive x := DirectSum.toAddMonoid_of _ _ _

theorem relationSum_surjective : Function.Surjective (relationSum G) := by
  let c := (Kernel (Relations G)).subtype.comp (relationSum G).toMultiplicativeLeft
  have hc : c.range ≤ Subgroup.center (Total (Relations G)) := by
    rintro z ⟨x, rfl⟩
    exact Subgroup.mem_center_iff.mpr (fun y ↦
      (kernel_central (Relations G) _ ((relationSum G).toMultiplicativeLeft x).property y).symm)
  let : c.range.Normal := Subgroup.normal_of_le_center hc
  have hN : Relations G ≤ c.range.comap (QuotientGroup.mk' (commutatorKernel (Relations G))) := by
    apply (relations_eq_normalClosure G).le.trans
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨⟨a, r⟩, rfl⟩
    refine ⟨Multiplicative.ofAdd (DirectSum.of
      (fun a ↦ Additive (Kernel (canonicalRelations (G a)))) a
      (Additive.ofMul (RelationCoordinates.toCoinvariants (canonicalRelations (G a)) r))), ?_⟩
    change (relationSum G (DirectSum.of _ a _)).toMul.val = _
    rw [relationSum_of]
    rfl
  intro z
  obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective (commutatorKernel (Relations G)) z.toMul.val
  have hxN : x ∈ Relations G := by
    apply (QuotientGroup.eq_one_iff x).mp
    change RelationExtension.projection (Relations G)
      (QuotientGroup.mk' (commutatorKernel (Relations G)) x) = 1
    rw [hx]
    exact z.toMul.property
  obtain ⟨v, hv⟩ := hN hxN
  refine ⟨v.toAdd, ?_⟩
  apply Additive.toMul.injective
  apply Subtype.ext
  exact hv.trans hx

/-- The free-group retraction kills generators from every other factor. -/
noncomputable def retraction (a : A) : Free G →* FreeGroup (G a) :=
  FreeGroup.lift (fun x : Σ b, G b ↦
    if h : x.1 = a then FreeGroup.of (h ▸ x.2) else 1)

omit [∀ a, Group (G a)] in
@[simp] theorem retraction_factor (a : A) :
    (retraction G a).comp (factor G a) = MonoidHom.id _ := by
  apply FreeGroup.ext_hom
  intro x
  simp [retraction, factor]

omit [∀ a, Group (G a)] in
theorem retraction_factor_ne (a b : A) (h : b ≠ a) :
    (retraction G a).comp (factor G b) = 1 := by
  apply FreeGroup.ext_hom
  intro x
  simp [retraction, factor, h]

theorem retraction_projection (a : A) :
    (freeProjection (G a)).comp (retraction G a) =
      (freeProductRetraction G a).comp (projection G) := by
  apply FreeGroup.ext_hom
  rintro ⟨b, x⟩
  by_cases h : b = a
  · subst b
    simp [retraction, projection, freeProjection, freeProductRetraction]
  · simp [retraction, projection, freeProjection, freeProductRetraction, h]

theorem retraction_relations (a : A) : Relations G ≤
    (canonicalRelations (G a)).comap (retraction G a) := by
  intro x hx
  change freeProjection (G a) (retraction G a x) = 1
  rw [← MonoidHom.comp_apply, retraction_projection, MonoidHom.comp_apply,
    show projection G x = 1 from hx, map_one]

/-- The retractions descend to the central relation extensions. -/
noncomputable def retractionTotal (a : A) : Total (Relations G) →* Total (canonicalRelations (G a)) :=
  totalMap _ _ (retraction G a) (retraction_relations G a)

@[simp] theorem retractionTotal_factor (a : A) (x : Total (canonicalRelations (G a))) :
    retractionTotal G a (factorTotal G a x) = x := by
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective _ x
  change QuotientGroup.mk' (commutatorKernel (canonicalRelations (G a)))
    (retraction G a (factor G a w)) = QuotientGroup.mk' _ w
  exact congrArg (QuotientGroup.mk' _) (DFunLike.congr_fun (retraction_factor G a) w)

theorem retractionTotal_factor_ne (a b : A) (h : b ≠ a)
    (x : Total (canonicalRelations (G b))) :
    retractionTotal G a (factorTotal G b x) = 1 := by
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective _ x
  change QuotientGroup.mk' (commutatorKernel (canonicalRelations (G a)))
    (retraction G a (factor G b w)) = 1
  rw [show retraction G a (factor G b w) = 1 from
    DFunLike.congr_fun (retraction_factor_ne G a b h) w, map_one]

noncomputable def retractionKernel (a : A) : Kernel (Relations G) →*
    Kernel (canonicalRelations (G a)) :=
  ((retractionTotal G a).comp (Kernel (Relations G)).subtype).codRestrict _ (by
    intro x
    change RelationExtension.projection (canonicalRelations (G a))
      (retractionTotal G a x.val) = 1
    rw [retractionTotal, totalMap_projection,
      show RelationExtension.projection (Relations G) x.val = 1 from x.property, map_one])

/-- The factor retractions recover the individual relation coordinates. -/
theorem relationSum_retraction (a : A)
    (x : ⨁ a, Additive (Kernel (canonicalRelations (G a)))) :
    (retractionKernel G a).toAdditive (relationSum G x) = x a := by
  let component : (⨁ a, Additive (Kernel (canonicalRelations (G a)))) →+
      Additive (Kernel (canonicalRelations (G a))) :=
    { toFun := fun x ↦ x a, map_zero' := rfl, map_add' := fun _ _ ↦ rfl }
  have h : (retractionKernel G a).toAdditive.comp (relationSum G) = component := by
    apply DirectSum.addHom_ext
    intro b z
    change (retractionKernel G a).toAdditive
      (relationSum G (DirectSum.of
        (fun a ↦ Additive (Kernel (canonicalRelations (G a)))) b z)) =
          (DirectSum.of (fun a ↦ Additive (Kernel (canonicalRelations (G a)))) b z) a
    rw [relationSum_of]
    by_cases hba : b = a
    · subst b
      rw [DirectSum.of_eq_same]
      apply Additive.toMul.injective
      apply Subtype.ext
      exact retractionTotal_factor G a z.toMul.val
    · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm hba)]
      apply Additive.toMul.injective
      apply Subtype.ext
      exact retractionTotal_factor_ne G a b hba z.toMul.val
  exact DFunLike.congr_fun h x

end SmallPresentationStatements.Homology.FreeProductPresentation
